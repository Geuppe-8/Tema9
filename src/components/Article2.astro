---
import "../styles/style.css";
const { img, title, body, beskrivelse } = Astro.props;
---

<div class="article-section2">
  <div class="tekst">
    <h2>{title}</h2>
    <p>{body}</p>
  </div>
  <div class="billede">
    <img src={img} alt={beskrivelse} />
  </div>
</div>

<style>
  .article-section2 {
    padding: 120px 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  img {
    width: 400px;
    padding-bottom: 30px;
  }

  h2 {
    padding-bottom: 30px;
  }

  p {
    padding-bottom: 50px;
  }

  @media (min-width: 800px) {
    .article-section2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      text-align: left;
      gap: 250px;
      padding: 120px 120px;
    }
  }
</style>
